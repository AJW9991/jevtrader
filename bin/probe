#!/opt/homebrew/bin/python3
"""bin/probe -- PREREG-v2 §2's product probe: two added products, chosen by its criteria over ONE fixed UTC day.

    bin/probe run --day YYYY-MM-DD --out DIR [--candidates ETH-USD,XRP-USD,...] [--start-second 30] [--every 60] [--max-minutes N]
    bin/probe volume --day YYYY-MM-DD --out DIR [--candidates ...]
    bin/probe summarize DIR [--tick-override ETH-USD=0.01,...]

run: every --every seconds, at wall second --start-second (with the defaults, at :30 of every
minute), takes each candidate in order through loop/feed.py::snapshot (the three public GETs the
loop uses: book, candles, ticker; 10 s timeout; no retry) and loop/state.py::features (the numbers
only), and appends one JSON line to DIR/<product>.jsonl: tick_id (the minute floor of ts_rx),
ts_rx, ok, mid, spread_bps, fill1k_bps, fill1k_short, vol5_usd, trades_5m, feed_age_s and
tick_est, the smallest positive price step between consecutive levels of the book, one for the
asks and one for the bids, and gets: what each GET did, "ok" or the feed's error text (a transport
failure; the feed tolerates a failed ticker, so only this record shows one). A snapshot or a features() call that raises writes a row with ok false
and the exception's one-line text (no traceback), and the next candidate goes on. It samples the
UTC day --day only: before it, it waits; it exits 0 after the day's last slot (23:59:30 with the
defaults), and refuses a day that is already over. SIGTERM finishes the row being written and exits
0. No request of a cycle starts later than 60 - start_second - LIVE_GUARD_S seconds after its slot
(at the defaults :58, two seconds before the live loop's :00, which a slow cycle would otherwise
reach: 18 GETs of up to 10 s each): a candidate not begun by then gets no row that minute (counted
as skipped), and a GET that would start after it is not sent (the row's record says "deadline",
which is no transport failure). One line an hour goes to stderr with the counts so far. DIR/run.json records the day, the
candidates, --every and --start-second; a restart into the same DIR continues the run only when
all four are the same (PREREG-v2 §2: a restart within D continues it), and is refused otherwise.
volume: once, after D closes (PREREG-v2 §2: on the next UTC day), the 30 closed ONE_DAY candles
ending with D (starts D-29 ... D) per candidate, from the venue's public candles endpoint ->
DIR/volume.json: D and the window, and per product the daily rows found in it, the raw candles and
sum(volume * close) / 30 in USD a day, which is null unless the rows are exactly those 30 days
(fewer rows fail criterion (2)). Refused (exit 2, nothing written) before D closes, when DIR's
run.json is of another day, and when volume.json exists: it runs once. Exit 1 when the endpoint
did not answer for a candidate (its entry holds the error; §2: criterion (2) is then restated).
summarize: offline, from DIR alone (run.json names the day and the candidates; a DIR without it is
refused): D's minutes with a row for any candidate, the transport failures summed over the
candidates, and whether D stands (PREREG-v2 §2: void when the probe wrote rows in fewer than 95 %
of its 1,440 minutes, or transport failures exceed 5 % of its minutes summed over the candidates);
per product the rows (one a minute: a repeated minute is counted and dropped), the ok rows (the
three public GETs answered and features computed) as a share of those minutes, the tick size (the
mode of the ok rows' tick_est values, both sides, ties the smaller, or --tick-override), the median
fill1k_bps, the nearest-rank quantiles of h and the atoms, the liq occupancy of the ok rows under
the h-rule of bin/fill1k-quantiles (imported from it: one rule, one place), the 30-day volume,
PASS/FAIL per criterion with the failing value, and the first two passing products in candidate
order, or none when D is void (exit 1).

Rate: this process never starts two requests less than MIN_GAP_S = 1 s apart. feed.snapshot sends
its three GETs back to back, so the probe routes each of them through its pacer by wrapping
feed._get in this process only (the loop's own processes never import this file). So that the
rate holds overall and not per process, one run or volume at a time: each holds an exclusive
flock on this file itself (LOCK_PATH, opened read-only: no lock file is written) for its whole
life, and a second run or volume, into any DIR, is refused (exit 2) before it creates anything.
Six candidates are 18 GETs a minute, ~18 s of the 60.
Writes only DIR/<product>.jsonl, DIR/run.json and DIR/volume.json, each opened without following
a symlink and written only when it is a regular file with one link (a file in DIR that is a symlink
or a hard link to somewhere else is refused, exit 3, and nothing is written through it). DIR is refused (exit 3, before
anything is created) when it resolves inside the live checkout LIVE_CHECKOUT, under a forbidden
prefix of loop/config.py, or under any directory named data or logs (PREREG-v2 §2: nothing under
any data/ or logs/). Never imports the loop's send path
(its jev and cycle modules); nothing here sends to Jev or reads a key. Exit 2 on a usage error.
"""
import argparse, collections, contextlib, datetime as dt, fcntl, importlib.machinery, importlib.util, json, math, os, re
import signal, stat, statistics, sys, time

HERE = os.path.dirname(os.path.abspath(__file__))
REPO = os.path.dirname(HERE)
sys.path.insert(0, REPO)
from loop import config, feed, state                       # noqa: E402

# ---- PREREG-v2 §2 (main at 467cda4, "the recheck applied", 2026-09-29) --------------------------
DEFAULT_CANDIDATES = ("ETH-USD", "XRP-USD", "DOGE-USD", "AVAX-USD", "LINK-USD", "ADA-USD")   # walked in this order
CHOOSE = 2                          # the first two that pass all four
MIN_USD_PER_DAY = 50e6              # 30-day volume on the venue's own daily candles, USD a day
VOLUME_DAYS = 30
OCC_LO_PCT, OCC_HI_PCT = 3, 90      # every liq word, under the h-rule, holds 3-90 % of the day's rows
OK_ROWS_MIN_PCT = 99                # (1) a candidate's ok rows (the three public GETs answered, features
                                    #     computed) >= this share of D's minutes with a row for any candidate
DAY_MINUTES = 1440
DAY_ROWS_MIN_PCT = 95               # D is void if the probe wrote rows in fewer than this share of its minutes,
TRANSPORT_MAX_PCT = 5               # or if transport failures exceed this share of D's minutes x candidates
STABLECOINS = frozenset({"USDT", "USDC", "DAI", "PYUSD", "EURC", "GUSD", "USDP", "PAX", "TUSD", "FDUSD",
                         "USDS", "RLUSD", "BUSD", "LUSD", "FRAX", "USDE"})   # a base here fails "no stablecoin"
# ---- the probe's own ---------------------------------------------------------------------------
MIN_GAP_S = 1.0                     # never two requests less than this apart, whatever the endpoint
LIVE_GUARD_S = 2                    # a cycle's last request starts at least this long before the live loop's :00
DEADLINE = "deadline"               # a GET's record when the cycle's deadline stopped it (not a transport failure)
LOCK_PATH = os.path.abspath(__file__)   # run and volume flock this file (read-only): one of them at a time
LIVE_CHECKOUT = "/Users/alexanderward/Projects/jev-paper-loop"
FORBIDDEN = (LIVE_CHECKOUT,) + tuple(config.FORBIDDEN_PREFIXES)
FORBIDDEN_NAMES = ("data", "logs")  # no path component of DIR, typed or resolved, is one of these (any case)
PRODUCT_RE = re.compile(r"^[A-Z0-9]{2,12}-[A-Z]{3,5}$")
DAY_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")
MINUTE_RE = re.compile(r"^\d{8}T\d{4}00Z$")
GETS = ("book", "candles", "ticker")    # the feed's three public GETs, in the order it sends them


def _load_rule():
    """bin/fill1k-quantiles as a module (no bytecode written next to it)."""
    path = os.path.join(HERE, "fill1k-quantiles")
    loader = importlib.machinery.SourceFileLoader("fill1k_quantiles", path)
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader("fill1k_quantiles", loader))
    before, sys.dont_write_bytecode = sys.dont_write_bytecode, True
    try:
        loader.exec_module(mod)
    finally:
        sys.dont_write_bytecode = before
    return mod


RULE = _load_rule()


# ---- the path guard ----------------------------------------------------------------------------
def refused(path, prefixes=None):
    """Why DIR may not be written, or None. As loop/cycle.py::forbidden: the path as typed (made
    absolute) and its realpath are both tried, each prefix and its realpath matched on a '/'
    boundary, then each existing ancestor of the realpath compared with each existing prefix by
    (st_dev, st_ino), so a symlink, a '..', or a case-only second name on APFS cannot hide the
    tree. Any path component named data or logs (any case), typed or resolved, is refused too.
    prefixes defaults to FORBIDDEN."""
    prefixes = FORBIDDEN if prefixes is None else prefixes
    typed, real = os.path.abspath(path), os.path.realpath(path)
    for p in (typed, real):
        for part in p.split(os.sep):
            if part.casefold() in FORBIDDEN_NAMES:
                return f"{p} has a directory named {part.casefold()} in it"
    for pre in prefixes:
        for q in {pre.rstrip(os.sep), os.path.realpath(pre).rstrip(os.sep)}:
            for p in (typed, real):
                if p == q or p.startswith(q + os.sep):
                    return f"{p} is inside {pre}"
    ids = []
    for pre in prefixes:
        try:
            st = os.stat(pre)
        except (OSError, ValueError):
            continue
        ids.append(((st.st_dev, st.st_ino), pre))
    a = real
    while ids:
        try:
            st = os.stat(a)
        except (OSError, ValueError):
            pass
        else:
            for key, pre in ids:
                if key == (st.st_dev, st.st_ino):
                    return f"{real} is inside {pre} (the same directory by another name)"
        up = os.path.dirname(a)
        if up == a:
            break
        a = up
    return None


class Refused(Exception):
    """A file inside DIR that is not a regular file of its own: nothing is written through it."""


def open_plain(path, flags):
    """os.open(path) for writing, never through a symlink (O_NOFOLLOW), and refused unless what is open
    is a regular file with one link, checked before a byte is written (no O_TRUNC here: the caller
    truncates after the check). O_NONBLOCK: a FIFO without a reader is refused, not waited on."""
    try:
        fd = os.open(path, flags | os.O_NOFOLLOW | os.O_NONBLOCK | getattr(os, "O_CLOEXEC", 0), 0o644)
    except OSError as e:
        raise Refused(f"{path}: {e.strerror or e} (a symlink is never written through)") from None
    st = os.fstat(fd)
    if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
        os.close(fd)
        raise Refused(f"{path} is not a regular file of its own (links {st.st_nlink}); nothing is written through it")
    return fd


def check_plain(path):
    """Refused unless path is absent or a regular file with one link (lstat: a symlink is refused)."""
    try:
        st = os.lstat(path)
    except FileNotFoundError:
        return
    if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
        raise Refused(f"{path} is not a regular file of its own (a symlink or a link); nothing is written through it")


def prepare_out(path, err):
    """The resolved DIR, created, or None after a refusal line (the caller exits 3)."""
    why = refused(path)
    if why is None:
        real = os.path.realpath(path)
        try:
            os.makedirs(real, exist_ok=True)
        except OSError as e:
            err.write(f"probe: cannot create {real}: {e.strerror or e}\n")
            return None
        why = refused(real)                                 # what was created is what was checked
        if why is None:
            return real
    err.write(f"probe: refusing --out {path}: {why}\n")
    return None


# ---- pacing --------------------------------------------------------------------------------------
class Pacer:
    """At least `gap` seconds between the starts of any two requests of this process."""
    def __init__(self, gap=MIN_GAP_S, clock=time.monotonic, sleep=time.sleep):
        self.gap, self.clock, self.sleep, self.last = gap, clock, sleep, None

    def ready(self):
        """Sleep until a request may start."""
        while self.last is not None:
            d = self.last + self.gap - self.clock()
            if d <= 0:
                return
            self.sleep(d)

    def mark(self):
        """Wait if needed, then count a request as started now."""
        self.ready()
        self.last = self.clock()


def endpoint(url):
    """Which of the feed's three GETs a URL is ("book", "candles", "ticker"), or its path."""
    for name, part in (("book", "/product_book?"), ("candles", "/candles?"), ("ticker", "/ticker?")):
        if part in url:
            return name
    return url[len(feed.BASE):].split("?")[0]


class Deadline:
    """The wall time from which no request of the current cycle may start (None: no limit)."""
    def __init__(self, wall):
        self.wall, self.at = wall, None

    def passed(self):
        return self.at is not None and self.wall() >= self.at


@contextlib.contextmanager
def paced_feed(pacer, gets=None, deadline=None):
    """Every feed._get in this process waits for the pacer first, and what it did goes into `gets`
    (the caller's dict, emptied per snapshot): endpoint -> "ok" when it answered, or the FeedError's
    text when it did not (http-..., net ..., parse ...: a transport failure). feed.snapshot
    swallows a failed ticker (trades_5m -1), so this record is the only place that failure shows.
    Once `deadline` has passed, a GET is not sent: it raises a FeedError and records DEADLINE.
    Restored on the way out."""
    real = feed._get

    def get(url):
        pacer.ready()
        name = endpoint(url)
        if deadline is not None and deadline.passed():
            if gets is not None:
                gets[name] = DEADLINE
            raise feed.FeedError(f"{DEADLINE}: no request of this cycle starts at or after {iso(deadline.at)}")
        pacer.mark()
        try:
            j = real(url)
        except feed.FeedError as e:
            if gets is not None:
                gets[name] = str(e)
            raise
        if gets is not None:
            gets[name] = "ok"
        return j
    feed._get = get
    try:
        yield
    finally:
        feed._get = real


def take_lock():
    """The open descriptor that holds the exclusive flock on LOCK_PATH, or None when another process
    holds it. The lock goes with the descriptor: closed, or the process gone, it is free."""
    fd = os.open(LOCK_PATH, os.O_RDONLY | getattr(os, "O_CLOEXEC", 0))
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(fd)
        return None
    return fd


# ---- one row -------------------------------------------------------------------------------------
def tick_id(now):
    return time.strftime("%Y%m%dT%H%M00Z", time.gmtime(now))


def iso(now):
    d = dt.datetime.fromtimestamp(now, dt.timezone.utc)
    return d.strftime("%Y-%m-%dT%H:%M:%S.") + f"{d.microsecond // 1000:03d}Z"


def one_line(e):
    return f"{type(e).__name__}: {e}".replace("\n", " ").replace("\r", " ")[:300]


def min_step(levels):
    """The smallest positive price difference between consecutive levels, or None."""
    d = [abs(b[0] - a[0]) for a, b in zip(levels, levels[1:])]
    d = [x for x in d if x > 0]
    return round(min(d), 10) if d else None


def probe_one(product, wall, pacer, gets=None):
    """One candidate: the snapshot and its features -> the row (never raises on a feed failure). `gets`
    is the dict paced_feed records each GET's outcome in; the row carries a copy."""
    gets = {} if gets is None else gets
    gets.clear()
    pacer.ready()
    now = wall()
    row = {"tick_id": tick_id(now), "ts_rx": iso(now), "product": product}
    try:
        snap = feed.snapshot(product, now=now)
        f = state.features(snap)
        row.update(ok=True, mid=f["mid"], spread_bps=f["spread_bps"], fill1k_bps=f["fill1k_bps"],
                   fill1k_short=f["fill1k_short"], vol5_usd=f["vol5_usd"], trades_5m=snap["trades_5m"],
                   feed_age_s=snap["feed_age_s"], tick_est={"ask": min_step(snap["asks"]), "bid": min_step(snap["bids"])})
    except Exception as e:                                   # a FeedError, a short window: the row says which
        row.update(ok=False, error=one_line(e))
    row["gets"] = dict(gets)
    return row


def append(out, product, row):
    try:
        line = json.dumps(row, sort_keys=True, allow_nan=False)
    except ValueError as e:                                  # a non-finite number: the row says so instead
        row = {k: row[k] for k in ("tick_id", "ts_rx", "product", "gets") if k in row}
        row.update(ok=False, error=one_line(e))
        line = json.dumps(row, sort_keys=True)
    fd = open_plain(os.path.join(out, f"{product}.jsonl"), os.O_WRONLY | os.O_APPEND | os.O_CREAT)
    with os.fdopen(fd, "a", encoding="utf-8") as fh:
        fh.write(line + "\n")
    return row


def _write_json(path, obj):
    tmp = path + ".tmp"
    check_plain(path)
    fd = open_plain(tmp, os.O_WRONLY | os.O_CREAT)
    os.ftruncate(fd, 0)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        json.dump(obj, fh, indent=1, sort_keys=True)
        fh.write("\n")
    os.replace(tmp, path)


# ---- run -----------------------------------------------------------------------------------------
def next_slot(t, start_second, every):
    """The first time >= t at start_second modulo every (whole seconds of the epoch)."""
    return start_second + every * math.ceil((t - start_second) / every)


def _counts(counts):
    return "; ".join(f"{p} ok {c['ok']} error {c['error']}" + (f" skipped {c['skipped']}" if c["skipped"] else "")
                     for p, c in counts.items())


def run(args, wall, mono, sleep, err):
    day0 = dt.datetime.strptime(args.day, "%Y-%m-%d").replace(tzinfo=dt.timezone.utc).timestamp()
    day1 = day0 + 86400
    if next_slot(max(wall(), day0), args.start_second, args.every) >= day1:
        err.write(f"probe: the UTC day {args.day} has no slot left; refusing\n")
        return 2
    out = prepare_out(args.out, err)
    if out is None:
        return 3
    for p in args.candidates:                                # before run.json: a refused DIR gets nothing
        check_plain(os.path.join(out, f"{p}.jsonl"))
    manifest = {"day": args.day, "candidates": list(args.candidates), "every": args.every,
                "start_second": args.start_second}
    mpath = os.path.join(out, "run.json")
    if os.path.exists(mpath):
        try:
            with open(mpath, encoding="utf-8") as fh:
                old = json.load(fh)
        except (OSError, ValueError) as e:
            err.write(f"probe: {mpath} cannot be read ({one_line(e)}); refusing\n")
            return 2
        if old != manifest:                                  # a resume continues the same run, or nothing
            err.write(f"probe: {out} holds a run of another day, candidate list, --every or --start-second"
                      f" ({json.dumps(old, sort_keys=True)}); use a fresh --out\n")
            return 2
    else:
        _write_json(mpath, manifest)
    stop = []

    def on_term(signum, frame):
        stop.append(signum)
    previous = signal.signal(signal.SIGTERM, on_term)
    counts = {p: {"ok": 0, "error": 0, "skipped": 0} for p in args.candidates}
    pacer, cycles, log_hour, last, why = Pacer(MIN_GAP_S, mono, sleep), 0, None, day0 - 1, "the day is over"
    err.write(f"{iso(wall())} probe: run {args.day} into {out}, {len(args.candidates)} candidates,"
              f" every {args.every} s at second {args.start_second}\n")
    try:
        gets, deadline = {}, Deadline(wall)
        with paced_feed(pacer, gets, deadline):
            while not stop:
                slot = next_slot(max(wall(), day0, last + 1), args.start_second, args.every)   # never one slot twice
                if slot >= day1:
                    break
                last = slot
                while not stop:
                    d = slot - wall()
                    if d <= 0:
                        break
                    sleep(min(d, 1.0))                        # short naps: a SIGTERM is seen within a second
                if stop:
                    break
                hour = int(slot // 3600)
                if log_hour is not None and hour != log_hour:
                    err.write(f"{iso(slot)} probe: {cycles} cycles; {_counts(counts)}\n")
                log_hour = hour
                deadline.at = slot + 60 - LIVE_GUARD_S - args.start_second   # :58 at the defaults
                for p in args.candidates:
                    if stop:
                        break
                    if deadline.passed():                     # not begun by the deadline: no row this minute
                        counts[p]["skipped"] += 1
                        continue
                    row = append(out, p, probe_one(p, wall, pacer, gets))
                    counts[p]["ok" if row["ok"] else "error"] += 1
                if stop:
                    break                                     # a cycle cut short is not counted as one
                cycles += 1
                if args.max_minutes and cycles >= args.max_minutes:
                    why = f"--max-minutes {args.max_minutes}"
                    break
    finally:
        signal.signal(signal.SIGTERM, signal.SIG_DFL if previous is None else previous)
    if stop:
        why = "SIGTERM"
    err.write(f"{iso(wall())} probe: done ({why}), {cycles} cycles; {_counts(counts)}\n")
    return 0


# ---- volume --------------------------------------------------------------------------------------
def daily_rows(j, start, end):
    """Closed daily candles with start in [start, end), oldest first, as (start, volume, close)."""
    raw = j.get("candles") if isinstance(j, dict) else None
    if not isinstance(raw, list):
        raise feed.FeedError("parse daily candles: no list")
    seen = {}
    for c in raw:
        try:
            s, v, px = int(c["start"]), float(c["volume"]), float(c["close"])
        except (KeyError, TypeError, ValueError, OverflowError):
            raise feed.FeedError("parse daily candles: a row without start, volume or close") from None
        if not (math.isfinite(v) and v >= 0 and math.isfinite(px) and px > 0):
            raise feed.FeedError(f"daily candle {s}: volume {v} close {px}")
        if start <= s < end:
            seen[s] = (s, v, px)
    return [seen[s] for s in sorted(seen)]


def volume_window(day):
    """[start, end) of the VOLUME_DAYS daily candles ending with the UTC day `day`: D-29 00:00Z to D+1 00:00Z."""
    end = int(dt.datetime.strptime(day, "%Y-%m-%d").replace(tzinfo=dt.timezone.utc).timestamp()) + 86400
    return end - VOLUME_DAYS * 86400, end


def volume(args, wall, mono, sleep, err):
    start, end = volume_window(args.day)
    now = wall()
    if now < end:                                            # D's own candle is still open
        err.write(f"probe: {args.day} closes at {iso(end)}; volume runs once after it; refusing\n")
        return 2
    out = prepare_out(args.out, err)
    if out is None:
        return 3
    try:
        with open(os.path.join(out, "run.json"), encoding="utf-8") as fh:
            ran = json.load(fh).get("day")
    except FileNotFoundError:
        ran = args.day
    except (OSError, ValueError, AttributeError) as e:
        err.write(f"probe: {out}/run.json cannot be read ({one_line(e)}); refusing\n")
        return 2
    if ran != args.day:
        err.write(f"probe: {out} holds the run of {ran}, not {args.day}; refusing\n")
        return 2
    vpath = os.path.join(out, "volume.json")
    if os.path.lexists(vpath):
        err.write(f"probe: {vpath} exists; volume runs once; refusing\n")
        return 2
    want = [start + k * 86400 for k in range(VOLUME_DAYS)]
    pacer, products, silent = Pacer(MIN_GAP_S, mono, sleep), {}, []
    with paced_feed(pacer):
        for p in args.candidates:
            url = f"{feed.BASE}/products/{p}/candles?start={start}&end={end}&granularity=ONE_DAY"
            try:
                j = feed._get(url)
                rows = daily_rows(j, start, end)
            except Exception as e:
                products[p] = {"error": one_line(e)}
                silent.append(p)
                err.write(f"probe: volume {p}: {products[p]['error']}\n")
                continue
            whole = [s for s, _, _ in rows] == want
            products[p] = {"rows": len(rows), "candles": j["candles"],
                           "usd_per_day": sum(v * px for _, v, px in rows) / VOLUME_DAYS if whole else None}
            err.write(f"probe: volume {p}: " + (f"${products[p]['usd_per_day']:,.0f}/day over {len(rows)} rows" if whole
                                                  else f"{len(rows)} daily rows, not the {VOLUME_DAYS} days ending with"
                                                       f" {args.day}: no figure") + "\n")
    _write_json(vpath, {"generated": iso(now), "day": args.day, "start": iso(start), "end": iso(end),
                        "days": VOLUME_DAYS, "products": products})
    if silent:
        err.write(f"probe: the candles endpoint did not answer for {' '.join(silent)} (PREREG-v2 §2: criterion (2)"
                  " is then restated in §14)\n")
        return 1
    return 0


# ---- summarize -----------------------------------------------------------------------------------
def read_rows(path, day):
    """One product's rows of `day`, one a minute, and the counts of what was not read: "bad" (a line
    that does not parse, or is not a probe row: a dict with a minute tick_id, a boolean ok and a gets
    record), "outside" (a row of another day) and "repeated" (a second row for a minute already read;
    the first is kept, as the run writes one a minute)."""
    rows, c, seen = [], {"bad": 0, "outside": 0, "repeated": 0}, set()
    if not os.path.exists(path):
        return rows, c
    prefix = day.replace("-", "") + "T"
    with open(path, "rb") as fh:
        for raw in fh:
            if not raw.strip():
                continue
            try:
                r = json.loads(raw.decode("utf-8"))
            except (UnicodeDecodeError, ValueError, RecursionError):
                c["bad"] += 1
                continue
            if not (isinstance(r, dict) and isinstance(r.get("tick_id"), str) and MINUTE_RE.match(r["tick_id"])
                    and isinstance(r.get("ok"), bool) and isinstance(r.get("gets"), dict)):
                c["bad"] += 1
                continue
            if not r["tick_id"].startswith(prefix):
                c["outside"] += 1
                continue
            if r["tick_id"] in seen:
                c["repeated"] += 1
                continue
            seen.add(r["tick_id"])
            rows.append(r)
    return rows, c


def _num(x):
    return isinstance(x, (int, float)) and not isinstance(x, bool) and math.isfinite(x)


def ok_row(r):
    """PREREG-v2 §2 (1): the three public GETs answered (each "ok" in the row's record, and the ticker's
    answer a trades list: trades_5m >= 0) and features computed (ok true)."""
    t = r.get("trades_5m")
    return (r["ok"] is True and all(r["gets"].get(k) == "ok" for k in GETS)
            and isinstance(t, int) and not isinstance(t, bool) and t >= 0)


def transport_failed(r):
    """A GET of this row did not answer (its record holds the feed's error text). A window the feed
    refused (a quiet minute, a stale candle) is not one: its three GETs answered; nor is a GET the
    cycle's deadline kept from being sent."""
    return any(v not in ("ok", DEADLINE) for v in r["gets"].values())


def tick_mode(rows):
    """The most frequent tick_est value over both sides of `rows` (ties: the smaller), with its count
    and the number of values seen; (None, 0, 0) when no row recorded one."""
    seen = collections.Counter()
    for r in rows:
        te = r.get("tick_est")
        for side in ("ask", "bid"):
            v = te.get(side) if isinstance(te, dict) else None
            if _num(v) and v > 0:
                seen[v] += 1
    if not seen:
        return None, 0, 0
    best = min(seen, key=lambda v: (-seen[v], v))
    return best, seen[best], sum(seen.values())


def _pct(k, n):
    return f"{k}/{n} {100.0 * k / n:.2f}%" if n else f"{k}/{n}"


def summarize_product(p, rows, counts, minutes, tick_override, vol):
    """(lines, passed) for one candidate; `minutes` is the number of D's minutes in which the probe
    wrote a row for any candidate, criterion (1)'s denominator."""
    ok = [r for r in rows if ok_row(r)]
    computed = sum(1 for r in rows if r["ok"] is True)
    lines = [f"== {p}",
             f"rows: {len(rows)} (features computed {computed}, error {len(rows) - computed};"
             f" unparsable lines {counts['bad']}, rows outside the day {counts['outside']},"
             f" repeated minutes {counts['repeated']})",
             f"transport_failures: {sum(1 for r in rows if transport_failed(r))}",
             f"ok_rows: {_pct(len(ok), minutes)}"]
    if tick_override is not None:
        tick = tick_override
        lines.append(f"tick: {tick!r} (--tick-override)")
    else:
        tick, agree, seen = tick_mode(ok)
        lines.append(f"tick: {tick!r} (mode of {seen} per-side minimum steps, {agree} at the mode)" if tick
                     else "tick: none (no ok row recorded a step)")
    fills = [(r["fill1k_bps"], r["mid"]) for r in ok if r.get("fill1k_short") is not True
             and _num(r.get("fill1k_bps")) and r["fill1k_bps"] >= 0 and _num(r.get("mid")) and r["mid"] > 0]
    n_short = sum(1 for r in ok if r.get("fill1k_short") is True)
    crit = {}
    crit["ok_rows"] = (None if minutes and len(ok) * 100 >= OK_ROWS_MIN_PCT * minutes
                       else f"{_pct(len(ok), minutes)} < {OK_ROWS_MIN_PCT}%")
    if fills:
        lines.append(f"fill1k_bps_median: {statistics.median(f for f, _ in fills):.4f}")
    if fills and tick:
        hs = [RULE.half_ticks(f, m, tick) for f, m in fills]
        q = RULE.summary(hs)
        occ = RULE.occupancy(hs, n_short, OCC_LO_PCT, OCC_HI_PCT)
        lines += [f"h_{k}: {q[k]:.4f}" for k in ("p10", "p50", "p90", "p99", "max")]
        lines += [f"a10: {occ['a10']}", f"a90: {occ['a90']}",
                  f"rule: deep iff h < {occ['deep_below']:.1f}; thin iff h > {occ['thin_above']:.1f} or fill1k_short;"
                  " normal otherwise",
                  "thin_fallback: " + (f"yes (thin held {_pct(occ['thin_before'], occ['n'])} under h > {occ['a90'] + 0.5:.1f})"
                                       if occ["fallback"] else "no")]
        lines += [f"{w}: {_pct(occ['counts'][w], occ['n'])}" for w in ("deep", "normal", "thin")]
        off = [f"{w} {100.0 * occ['counts'][w] / occ['n']:.2f}%" for w in ("deep", "normal", "thin")
               if not OCC_LO_PCT * occ["n"] <= occ["counts"][w] * 100 <= OCC_HI_PCT * occ["n"]]
        crit["occupancy"] = None if occ["within"] else ", ".join(off) + f" outside [{OCC_LO_PCT}%, {OCC_HI_PCT}%]"
    else:
        crit["occupancy"] = "no usable fill1k_bps in an ok row" if not fills else "no tick size"
    v = vol.get(p) if isinstance(vol, dict) else None
    if vol is None:
        crit["volume"] = "no volume.json"
    elif isinstance(vol, str):                               # a volume.json that is not D's
        crit["volume"] = vol
    elif not isinstance(v, dict):
        crit["volume"] = "not in volume.json"
    elif "error" in v:
        crit["volume"] = f"volume.json: {v['error']}"
    elif v.get("rows") != VOLUME_DAYS or not _num(v.get("usd_per_day")):
        crit["volume"] = f"{v.get('rows')} daily rows, not the {VOLUME_DAYS} days ending with D"
    else:
        lines.append(f"volume_usd_per_day: {v['usd_per_day']:.0f} ({v.get('rows')} daily rows / {VOLUME_DAYS})")
        crit["volume"] = None if v["usd_per_day"] >= MIN_USD_PER_DAY else f"{v['usd_per_day']:.0f} < {MIN_USD_PER_DAY:.0f}"
    base = p.split("-")[0]
    crit["stablecoin"] = f"{base} is a stablecoin" if base in STABLECOINS else None
    for k in ("ok_rows", "volume", "occupancy", "stablecoin"):
        lines.append(f"criterion_{k}: " + ("PASS" if crit[k] is None else f"FAIL {crit[k]}"))
    passed = all(c is None for c in crit.values())
    lines.append(f"result: {'PASS' if passed else 'FAIL'}")
    return lines, passed


def day_verdict(minutes, transport, n_candidates):
    """The reasons D is void (PREREG-v2 §2), empty when it stands: the probe wrote rows in fewer than
    DAY_ROWS_MIN_PCT of D's 1,440 minutes, or its transport failures exceed TRANSPORT_MAX_PCT of D's
    minutes summed over the candidates (1,440 x the number of candidates)."""
    why = []
    if minutes * 100 < DAY_ROWS_MIN_PCT * DAY_MINUTES:
        why.append(f"rows in {_pct(minutes, DAY_MINUTES)} of D's minutes < {DAY_ROWS_MIN_PCT}%")
    if transport * 100 > TRANSPORT_MAX_PCT * DAY_MINUTES * n_candidates:
        why.append(f"transport failures {_pct(transport, DAY_MINUTES * n_candidates)} > {TRANSPORT_MAX_PCT}%")
    return why


def run_json_problem(day, candidates):
    """Why run.json's day or candidates cannot be read as a run's, or None: the day a real UTC date
    YYYY-MM-DD, the candidates a non-empty list of distinct product names like ETH-USD (each is
    joined into a file name, so nothing else is let through)."""
    if not (isinstance(day, str) and DAY_RE.fullmatch(day)):
        return f"day {day!r} is not YYYY-MM-DD"
    try:
        dt.date.fromisoformat(day)
    except ValueError:
        return f"day {day!r} is not a date"
    if not candidates or len(set(map(repr, candidates))) != len(candidates):
        return "no candidates, or one named twice"
    bad = [c for c in candidates if not (isinstance(c, str) and PRODUCT_RE.fullmatch(c))]
    return f"candidate {bad[0]!r} is not a product name like ETH-USD" if bad else None


def summarize(args, out, err):
    d = args.dir
    if not os.path.isdir(d):
        err.write(f"probe: no directory {d}\n")
        return 2
    mpath = os.path.join(d, "run.json")
    try:
        with open(mpath, encoding="utf-8") as fh:
            m = json.load(fh)
        day, candidates = m["day"], list(m["candidates"])
    except FileNotFoundError:
        err.write(f"probe: {d} has no run.json: summarize reads a run's directory (its day is in run.json)\n")
        return 2
    except (OSError, ValueError, KeyError, TypeError) as e:
        err.write(f"probe: {mpath} cannot be read ({one_line(e)})\n")
        return 2
    why = run_json_problem(day, candidates)
    if why:                                                  # names joined into paths below: checked first
        err.write(f"probe: {mpath}: {why}; refusing\n")
        return 2
    vol, (vstart, vend) = None, volume_window(day)
    vpath = os.path.join(d, "volume.json")
    if os.path.exists(vpath):
        try:
            with open(vpath, encoding="utf-8") as fh:
                vj = json.load(fh)
            vol = vj.get("products")
        except (OSError, ValueError, AttributeError) as e:
            err.write(f"probe: {vpath} cannot be read ({one_line(e)})\n")
            return 2
        if (vj.get("day"), vj.get("start"), vj.get("end")) != (day, iso(vstart), iso(vend)):
            vol = (f"volume.json is for {vj.get('day')} ({vj.get('start')} to {vj.get('end')}),"
                   f" not {day} ({iso(vstart)} to {iso(vend)})")
    read = {p: read_rows(os.path.join(d, f"{p}.jsonl"), day) for p in candidates}
    minutes = len({r["tick_id"] for rows, _ in read.values() for r in rows})
    transport = sum(1 for rows, _ in read.values() for r in rows if transport_failed(r))
    void = day_verdict(minutes, transport, len(candidates))
    lines = [f"dir: {d}", f"day: {day}", f"candidates: {' '.join(candidates)}",
             f"criteria: (1) ok rows (the three public GETs answered, features computed) >= {OK_ROWS_MIN_PCT}%"
             f" of D's minutes with a row for any candidate; (2) sum(volume x close)/{VOLUME_DAYS} over exactly the"
             f" {VOLUME_DAYS} daily candles ending with D >= {MIN_USD_PER_DAY:.0f} USD/day; (3) each liq word in [{OCC_LO_PCT}%, {OCC_HI_PCT}%] of D's ok rows under the"
             " h-rule; (4) not a stablecoin",
             f"minutes_with_rows: {_pct(minutes, DAY_MINUTES)} (D is void below {DAY_ROWS_MIN_PCT}%)",
             f"transport_failures: {_pct(transport, DAY_MINUTES * len(candidates))} of D's minutes summed over"
             f" {len(candidates)} candidates (D is void above {TRANSPORT_MAX_PCT}%)",
             "day_valid: " + ("no (" + "; ".join(void) + ")" if void else "yes"),
             f"volume_window: {iso(vstart)} <= daily candle start < {iso(vend)}"]
    passing = []
    for p in candidates:
        rows, counts = read[p]
        plines, ok = summarize_product(p, rows, counts, minutes, args.tick_override.get(p), vol)
        lines += plines
        if ok:
            passing.append(p)
    chosen = passing[:CHOOSE]
    if void:
        lines.append(f"chosen: none (D is void; PREREG-v2 §2: D becomes the next UTC day, once, named in §14)")
    else:
        tail = "" if len(chosen) == CHOOSE else f" (only {len(chosen)} of {len(candidates)} passed; v2 runs on what passed)"
        lines.append(f"chosen: {' '.join(chosen) if chosen else 'none'}{tail}")
    out.write("\n".join(lines) + "\n")
    return 1 if void else 0


# ---- the command line ----------------------------------------------------------------------------
def _candidates(s):
    ps = [p.strip() for p in s.split(",") if p.strip()]
    if not ps or any(not PRODUCT_RE.match(p) for p in ps) or len(set(ps)) != len(ps):
        raise argparse.ArgumentTypeError("a comma-separated list of distinct products like ETH-USD")
    return tuple(ps)


def _day(s):
    try:
        if DAY_RE.match(s):
            dt.date.fromisoformat(s)
            return s
    except ValueError:
        pass
    raise argparse.ArgumentTypeError("a UTC date like 2026-10-01")


def _overrides(s):
    out = {}
    for part in (x.strip() for x in s.split(",") if x.strip()):
        p, _, v = part.partition("=")
        try:
            t = float(v)
        except ValueError:
            t = math.nan
        if not PRODUCT_RE.match(p) or not (math.isfinite(t) and t > 0):
            raise argparse.ArgumentTypeError("P=TICK pairs like ETH-USD=0.01")
        out[p] = t
    return out


def _positive(s):
    try:
        n = int(s)
    except ValueError:
        n = 0
    if n < 1:
        raise argparse.ArgumentTypeError("a whole number >= 1")
    return n


def _second(s):
    try:
        n = int(s)
    except ValueError:
        n = -1
    if not 0 <= n < 60 - LIVE_GUARD_S:
        raise argparse.ArgumentTypeError(f"a whole second 0-{59 - LIVE_GUARD_S} (a cycle's requests stop"
                                         f" {LIVE_GUARD_S} s before the next :00)")
    return n


def main(argv=None, wall=time.time, mono=time.monotonic, sleep=time.sleep, out=None, err=None):
    out, err = out or sys.stdout, err or sys.stderr
    ap = argparse.ArgumentParser(prog="bin/probe", description="PREREG-v2 section 2's product probe: two added"
                                 " products chosen by its criteria over one fixed UTC day, from public GETs only."
                                 " The docstring at the top of bin/probe says what each subcommand does.")
    sub = ap.add_subparsers(dest="cmd", required=True)
    r = sub.add_parser("run", help="sample the candidates once a slot over one UTC day")
    r.add_argument("--day", required=True, type=_day)
    r.add_argument("--out", required=True)
    r.add_argument("--candidates", type=_candidates, default=DEFAULT_CANDIDATES)
    r.add_argument("--start-second", type=_second, default=30)
    r.add_argument("--every", type=_positive, default=60)
    r.add_argument("--max-minutes", type=_positive, default=None,
                   help="stop after N cycles (one pass over the candidates; one a minute at the default --every); for tests")
    v = sub.add_parser("volume", help="once, after D: the 30 daily candles ending with D -> DIR/volume.json")
    v.add_argument("--day", required=True, type=_day)
    v.add_argument("--out", required=True)
    v.add_argument("--candidates", type=_candidates, default=DEFAULT_CANDIDATES)
    s = sub.add_parser("summarize", help="offline: the criteria per candidate and the two chosen")
    s.add_argument("dir")
    s.add_argument("--tick-override", type=_overrides, default={})
    args = ap.parse_args(argv)
    if args.cmd == "summarize":
        return summarize(args, out, err)
    lock = take_lock()
    if lock is None:
        err.write(f"probe: another bin/probe run or volume holds the lock on {LOCK_PATH}; refusing\n")
        return 2
    try:
        if args.cmd == "run":
            return run(args, wall, mono, sleep, err)
        return volume(args, wall, mono, sleep, err)
    except Refused as e:
        err.write(f"probe: refusing to write: {e}\n")
        return 3
    finally:
        os.close(lock)


if __name__ == "__main__":
    sys.exit(main())
